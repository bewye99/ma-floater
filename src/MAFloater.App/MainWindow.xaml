<Window x:Class="MAFloater.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MA Floater - Native foundation"
        Width="390" Height="150" MinWidth="330" MinHeight="136"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="True"
        Icon="Assets/ma-floater.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D2D5DC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#8B8F99" />
            <Setter Property="Background" Value="#33363E" />
            <Setter Property="BorderBrush" Value="#4B4E58" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
    </Window.Resources>

    <Border Background="#F014161B" BorderBrush="#626773" BorderThickness="1" CornerRadius="17">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" Width="78" Height="78" HorizontalAlignment="Left"
                    VerticalAlignment="Center" CornerRadius="8" Background="#262A33">
                <Image Source="Assets/ma-floater.png" Margin="8" Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="2,7,66,0">
                <TextBlock Text="Native foundation" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="MA Floater" Foreground="#BEC1C9" FontSize="12" Margin="0,3,0,0" />
                <TextBlock x:Name="StatusText" Text="Music Assistant • Setup will follow"
                           Foreground="#5CBFFF" FontSize="10" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Orientation="Horizontal" Margin="0,-6,-5,0">
                <Button x:Name="PinButton" Content="&#xE718;" ToolTip="Keep on top"
                        Style="{StaticResource ChromeButton}" Click="PinButton_Click" />
                <Button Content="&#xE921;" ToolTip="Minimize"
                        Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click" />
                <Button Content="&#xE8BB;" ToolTip="Close"
                        Style="{StaticResource ChromeButton}" Click="CloseButton_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#xE892;" ToolTip="Previous" IsEnabled="False"
                        Style="{StaticResource TransportButton}" />
                <Button Content="&#xE768;" ToolTip="Play" IsEnabled="False"
                        Style="{StaticResource TransportButton}" />
                <Button Content="&#xE893;" ToolTip="Next" IsEnabled="False"
                        Style="{StaticResource TransportButton}" />
                <Button Content="&#xE8B1;" ToolTip="Shuffle" IsEnabled="False"
                        Style="{StaticResource TransportButton}" />
                <Button Content="&#xE8EE;" ToolTip="Repeat" IsEnabled="False"
                        Style="{StaticResource TransportButton}" Margin="0" />
            </StackPanel>

            <Grid Grid.Column="1" Grid.Row="2" Margin="1,1,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#8B8F99"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="0" IsEnabled="False"
                        Margin="4,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="--%" Foreground="#8B8F99" FontSize="10"
                           TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
